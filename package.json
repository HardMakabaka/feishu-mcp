{
  "name": "feishu-knowledge-mcp",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Local-only Feishu knowledge MCP: source-level integration of two pinned upstreams, shared OAuth and safe knowledge workflows.",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "build": "node scripts/build.mjs",
    "start": "node src/main.mjs",
    "auth": "node src/main.mjs --auth",
    "doctor": "node scripts/doctor.mjs",
    "config": "node scripts/write-client-config.mjs",
    "test": "node scripts/test.mjs",
    "test:integration": "node --test tests/integration/upstream-regressions.test.mjs && node tests/integration/smoke.mjs",
    "test:live": "node tests/integration/live.mjs",
    "prepublishOnly": "node scripts/deny-publish.mjs"
  }
}
