# Copy this file to .env. Never paste the secret into a model conversation.
FEISHU_APP_ID=cli_replace_me
FEISHU_APP_SECRET=replace_me
# Must be exactly the same URL configured in the Feishu developer console.
FEISHU_OAUTH_CALLBACK_URL=http://localhost:3010/oauth/feishu/callback
# Relative paths below are resolved against this project, NOT the MCP client's cwd.
KNOWLEDGE_ROOT=./examples/knowledge
FUSION_DATA_DIR=./.local
# Optional: default destination for directory imports. Obtain it with kb_list_wikis.
FEISHU_WIKI_SPACE_ID=
FEISHU_WIKI_PARENT_NODE=
# docs+blocks' complete tool catalog is retained. Extra non-document modules opt in.
FUSION_BLOCK_MODULES=document
# Daily safe tools are always exposed. true also exposes native tools with prefixes.
FUSION_EXPOSE_NATIVE_TOOLS=false
# Native writes are less protected than kb_* planned writes. Enable deliberately.
FUSION_ALLOW_NATIVE_WRITES=false
# Separate switch for delete / overwrite-and-recreate native tools.
FUSION_ALLOW_NATIVE_DESTRUCTIVE=false
# Full original tools may read arbitrary local paths. They are NOT a filesystem sandbox.
# Directory imports keep media OFF by default; opt in per import plan after review.
FUSION_MAX_MARKDOWN_BYTES=10485760
FUSION_PLAN_TTL_MINUTES=30

# Optional: extra scopes only for explicitly enabled task/calendar/member tools.
FUSION_EXTRA_OAUTH_SCOPES=
